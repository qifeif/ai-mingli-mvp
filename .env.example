# 模型接入配置示例
# ------------------------------------------------------------
# 方式一：保留 Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# 方式二：国内 / OpenAI-compatible 平台
# DeepSeek 文本示例：
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_TEXT_MODEL=deepseek-chat
# LLM_CLASSIFY_MODEL=deepseek-chat
#
# 户型图视觉需要换成支持图片的模型平台，例如通义千问 VL / 豆包视觉 / GLM-4V：
# LLM_VISION_MODEL=qwen-vl-max-latest
#
# 如果某个平台不支持 response_format: {type:"json_object"}，打开下面这行：
# LLM_JSON_MODE=off

# Supabase 账号与用户数据存储
# ------------------------------------------------------------
# 1. 在 Supabase 建项目后,到 Project Settings → API 复制 Project URL 与 anon public key。
# 2. 在 SQL Editor 执行 supabase/schema.sql 建表。
# 3. service role key 只允许放服务端 .env,不要暴露到前端;本项目只在 server.js 内读取。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
